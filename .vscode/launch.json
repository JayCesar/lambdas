{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lambda: rodar local (debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_local.py",
      "args": ["events/falha.json", "--module", "app", "--handler", "handler"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Lambda: rodar local + log AWS",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_local.py",
      "args": ["events/falha.json", "--module", "app", "--handler", "handler", "--verbose-aws"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Testes: pytest (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-x", "-vv"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
